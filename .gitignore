# --- 1. Security (CRITICAL) ---
# Never commit environment variables or secrets
.env
.env.prod
.env.dev

# --- 2. The Heavy Data (Your specific requirement) ---
# We ignore the actual media folder so developers don't download 500GB of beetles.
# You will likely have an empty 'media' folder locally, or one with just 5 dummy images.
media/

# --- 3. Generated Static Files ---
# 'static/' is your source code (Keep it!). 
# 'staticfiles/' is the output of "collectstatic" for Nginx (Ignore it!).
staticfiles/

# --- 4. Pixi & Python Artifacts ---
# Ignore the installed environment folder, but KEEP pixi.lock
.pixi/
__pycache__/
*.pyc
*.pyo
*.pyd

# --- 5. Database & Logs ---
# We use Postgres in Docker, but ignore local sqlite fallbacks or dumps
db.sqlite3
*.sql
*.log
celerybeat-schedule

# --- 6. Temporary Uploads ---
# Your settings.py defines this for chunked uploads
tmp_uploads/

# --- 7. IDE & OS Junk ---
.vscode/
.idea/
.DS_Store
Thumbs.db