{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:8000/",
        "http://localhost:8000/beetles/",
        "http://localhost:8000/interactions/",
        "http://localhost:8000/tools/classify/",
        "http://localhost:8000/accounts/login/",
        "http://localhost:8000/accounts/signup/"
      ],
      "numberOfRuns": 3,
      "settings": { "preset": "desktop", "chromeFlags": "--no-sandbox" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.8 }],
        "categories:accessibility": ["warn", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
        "color-contrast": ["warn", { "minScore": 1 }],
        "meta-description": ["warn", { "minScore": 1 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
